Instance: BDLabTechnologistExample
InstanceOf: BDPractitioner
Usage: #example
Title: "Example of a Bangladesh Laboratory Technologist"
Description: "A laboratory technologist who holds no licence or registration number, identified by a staff ID assigned by the facility. Accepted on the facility's attestation. Identifier values are illustrative, not real."

* identifier[facilityStaffId].system = $BD-FACILITY-STAFF-ID
* identifier[facilityStaffId].value = "LAB-0042"
* name[0].use = #official
* name[0].text = "Example Technologist"
