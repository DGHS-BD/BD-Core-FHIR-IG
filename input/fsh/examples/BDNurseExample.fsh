Instance: BDNurseExample
InstanceOf: BDPractitioner
Usage: #example
Title: "Example of a Bangladesh Nurse"
Description: "A nurse with a BNMC registration number and no HRIS provider ID, as at a private facility. Not verifiable against a registry today; accepted on the facility's attestation when not recorded as a prescriber or orderer. Identifier values are illustrative, not real."

* identifier[bnmcReg].system = $BNMC-REG
* identifier[bnmcReg].value = "N-00000"
* name[0].use = #official
* name[0].text = "Example Nurse"
